# Supabase injects its project URL and keys in hosted Edge Functions.
# For local development, copy this file to .env and paste your local Supabase values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=YOUR_LOCAL_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_SALT=LOCAL_ONLY_CHANGE_THIS_VALUE
